# ============================================================
# Smart Contract Deployment Configuration (.env)
# ============================================================

# 1. Deployer Wallet Private Key (MUST have testnet/mainnet ETH for gas)
# Export from MetaMask: Account Details -> Show Private Key
PRIVATE_KEY=0x_your_private_key_here

# 2. RPC Endpoints (Optional: defaults to public RPCs if omitted)
# Sepolia: https://rpc.sepolia.org or Alchemy/Infura endpoint
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Base Sepolia: https://sepolia.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Arbitrum Sepolia
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# 3. Block Explorer Verification API Keys (Optional)
ETHERSCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
