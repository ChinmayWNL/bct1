# ============================================================
# Web Client Environment Configuration (.env.local)
# ============================================================

# XMTP Network Environment:
# - 'dev' (default): Connects to XMTP testnet network (recommended for Localhost, Sepolia, Base Sepolia)
# - 'production': Connects to XMTP mainnet network (use for production live dApp)
NEXT_PUBLIC_XMTP_ENV=dev

# Optional: Preferred Chain ID default (e.g. 11155111 for Sepolia, 84532 for Base Sepolia, 31337 for Hardhat)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=11155111
